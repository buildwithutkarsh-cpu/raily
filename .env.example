# ═══════════════════════════════════════════════════════════════
# RAILY — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Clerk Authentication ───────────────────────────────────
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# ─── Railway API ─────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
#
# Provider priority: Rapi (self-hosted) > RailKit (paid) > RapidAPI > IndianRailAPI > Mock
#
# Option A: Rapi (recommended — 100% free, self-hosted)
#   1. cd Rapi && npm install && npm run dev
#   2. Set RAPI_BASE_URL=http://localhost:3001
#   3. Leave all other API keys empty
#
# Option B: RailKit (paid, comprehensive)
#   1. Go to https://railkit.rajivdubey.dev and sign up
#   2. Set RAILKIT_API_KEY below
#
# Option C: RapidAPI (free tier available)
#   1. Subscribe to an Indian Railways RapidAPI plan
#   2. Set RAILWAY_API_KEY and RAILWAY_RAPIDAPI_HOST
#
# Default: mock data (no setup needed)
#   Leave all keys empty to use built-in mock data.
# ═══════════════════════════════════════════════════════════════

# Rapi self-hosted API URL (becomes primary when set)
# Start the Rapi server first: cd Rapi && npm run dev
RAPI_BASE_URL=

# RailKit API key (becomes primary when Rapi is not configured)
RAILKIT_API_KEY=

# Your Railway API key (fallback when neither Rapi nor RailKit configured)
RAILWAY_API_KEY=

# RapidAPI host header (only needed for RapidAPI)
# Example: "train-railway-api.p.rapidapi.com"
RAILWAY_RAPIDAPI_HOST=

# Custom base URL (optional)
# RAILWAY_API_BASE_URL=https://indianrailapi.com/api/v2

# Use mock data? Auto-set to false when RAPI_BASE_URL or RAILKIT_API_KEY is set
NEXT_PUBLIC_RAILWAY_USE_MOCK=true
