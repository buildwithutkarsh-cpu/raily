# ═══════════════════════════════════════════════════════════════
# RAILY — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Clerk Authentication ───────────────────────────────────
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# ─── Railway API ─────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
#
# Option A: RailKit (recommended — paid, most comprehensive)
#   1. Go to https://railkit.rajivdubey.dev and sign up
#   2. Subscribe to a paid plan and generate an API key
#   3. Set RAILKIT_API_KEY below
#   4. Leave NEXT_PUBLIC_RAILWAY_USE_MOCK=false (or remove it)
#
# Option B: RapidAPI (free tier available)
#   1. Go to https://rapidapi.com and create an account
#   2. Search for "Indian Railways" or "Train Railway API"
#   3. Subscribe to a free tier
#   4. Copy your API key from the "Code Snippets" section
#   5. Note the x-rapidapi-host (e.g. "train-railway-api.p.rapidapi.com")
#   6. Set RAILWAY_API_KEY and RAILWAY_RAPIDAPI_HOST below
#
# Option C: Direct API (indianrailapi.com)
#   1. Go to https://indianrailapi.com and sign up
#   2. Get your API key from the dashboard
#   3. Set RAILWAY_API_KEY below
#   4. Leave RAILWAY_RAPIDAPI_HOST empty
#
# Default: mock data (no setup needed)
#   Leave all API keys empty to use built-in mock data.
# ═══════════════════════════════════════════════════════════════

# RailKit API key (becomes the primary provider when set)
# Get yours at https://railkit.rajivdubey.dev/dashboard
RAILKIT_API_KEY=

# Your Railway API key (fallback when RailKit is not configured)
# RapidAPI users: paste your x-rapidapi-key here
# indianrailapi.com users: paste your API key here
RAILWAY_API_KEY=

# RapidAPI host header (only needed for RapidAPI)
# Example: "train-railway-api.p.rapidapi.com"
RAILWAY_RAPIDAPI_HOST=

# Custom base URL (optional - defaults to https://indianrailapi.com/api/v2)
# Override if using a different API provider
# RAILWAY_API_BASE_URL=https://indianrailapi.com/api/v2

# Use mock data? Set to "false" to call the real API
# Auto-set to false when RAILKIT_API_KEY is provided
NEXT_PUBLIC_RAILWAY_USE_MOCK=true
