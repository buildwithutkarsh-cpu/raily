# ═══════════════════════════════════════════════════════════════
# RAILY — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Clerk Authentication ───────────────────────────────────ī
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# ─── Railway API ─────────────────────────────────────────────
# ═══════════════════════════════════════════════════════════════
#
# Provider priority: Rapi (deployed / self-hosted) > RailKit (paid) > RapidAPI > IndianRailAPI > Mock
#
# Option A (✅ LIVE): Rapi deployed on Render — 100% free, works out of the box
#   Set RAPI_BASE_URL=https://raily.onrender.com
#   Leave all other API keys empty.
#
# Option B: Rapi (self-hosted on localhost)
#   cd Rapi && npm install && npm run dev
#   Set RAPI_BASE_URL=http://localhost:3001
#
# Option C: RailKit (paid, comprehensive)
#   Go to https://railkit.rajivdubey.dev and sign up
#   Set RAILKIT_API_KEY below
#
# Option D: RapidAPI (free tier available)
#   Subscribe to an Indian Railways RapidAPI plan
#   Set RAILWAY_API_KEY and RAILWAY_RAPIDAPI_HOST
#
# Default: mock data (no setup needed)
#   Leave all keys empty to use built-in mock data.
# ═══════════════════════════════════════════════════════════════

# Rapi API URL (becomes primary when set — no API key required!)
# Use NEXT_PUBLIC_ variant so it's accessible from the browser (booking-store runs on the client)
# Deployed instance: https://raily.onrender.com
# Local instance:    http://localhost:3001
NEXT_PUBLIC_RAPI_BASE_URL=https://raily.onrender.com

# Server-side-only fallback (only read by API routes and server components)
RAPI_BASE_URL=https://raily.onrender.com

# RailKit API key (becomes primary when Rapi is not configured)
RAILKIT_API_KEY=

# Your Railway API key (fallback when neither Rapi nor RailKit configured)
RAILWAY_API_KEY=

# RapidAPI host header (only needed for RapidAPI)
# Example: "train-railway-api.p.rapidapi.com"
RAILWAY_RAPIDAPI_HOST=

# Custom base URL (optional)
# RAILWAY_API_BASE_URL=https://indianrailapi.com/api/v2

# Set to true to force mock data (disable when using live Rapi)
NEXT_PUBLIC_RAILWAY_USE_MOCK=

# ═══════════════════════════════════════════════════════════════
# ─── Email (Ticket PDF Delivery) ─────────────────────────────
# ═══════════════════════════════════════════════════════════════
#
# The ticket booking simulation generates a PDF and sends it to
# the user's email. Requires Resend (free tier: 100 emails/day).
# Get your API key at https://resend.com
#
# Without this key, users can still download the PDF from the
# browser but won't receive it via email.
# ═══════════════════════════════════════════════════════════════

# Resend API key for sending ticket PDFs via email
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=

# Resend verified sender email (defaults to onboarding@resend.dev)
# Must be verified in your Resend dashboard
RESEND_FROM_EMAIL=
