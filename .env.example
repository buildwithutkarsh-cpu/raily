# ═══════════════════════════════════════════════════════════════
# RAILY — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.
#
# KEY SECURITY RULE:
# Variables prefixed with NEXT_PUBLIC_ are bundled into client-side
# JavaScript. Only use these for values that MUST be public.
# API keys and secrets MUST NOT have the NEXT_PUBLIC_ prefix.
# ═══════════════════════════════════════════════════════════════

# ─── AI Provider ─────────────────────────────────────────────
# API keys are server-only (no NEXT_PUBLIC_ prefix).
# The client proxies through /api/ai/chat, so keys stay secure.
#
# Primary: Groq (free, fast). Get your key: https://console.groq.com
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#
# Fallback: OpenRouter. Get your key: https://openrouter.ai/keys
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# ─── Clerk Authentication ───────────────────────────────────
# Get your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ─── RAPI Server ─────────────────────────────────────────────
# Local: http://localhost:3001 (start with: cd Rapi && npm run dev)
# Deployed: https://raily.onrender.com
NEXT_PUBLIC_RAPI_BASE_URL=http://localhost:3001
RAPI_BASE_URL=http://localhost:3001

# ─── Email (Ticket PDF Delivery) ─────────────────────────────
# Get your key at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
