# ═══════════════════════════════════════════════════════════════
# RAPI — Self-hosted Indian Railways API
# ═══════════════════════════════════════════════════════════════
# Copy to .env and fill in if needed.

PORT=3001
NODE_ENV=development

# ─── Cache Configuration ─────────────────────────────────────
# Each data type has a configurable TTL to balance freshness vs
# upstream rate-limiting. Higher TTL = fewer scrapes = lower risk
# of IP blocking.
#
# All TTLs are in seconds.

# PNR status TTL (default: 3 min)
CACHE_TTL_PNR=180

# Live train status TTL (default: 2 min)
CACHE_TTL_LIVE=120

# Seat availability TTL (default: 2 min)
CACHE_TTL_AVAIL=120

# Train search results TTL (default: 10 min — schedules rarely change)
CACHE_TTL_SEARCH=600

# Train route info TTL (default: 24 hours — routes are static)
CACHE_TTL_ROUTES=86400

# Maximum cache entries (default: 5000) — prevents memory exhaustion
CACHE_MAX_KEYS=5000

# Stale-while-revalidate grace period (default: 10 min)
# After a key's TTL expires, stale data is served for this long
# while a background refresh fetches fresh data.
CACHE_STALE_TTL=600

# Minimum interval between scrapes of the same key (default: 30s)
# Prevents rapid successive scrapes of the same data.
CACHE_MIN_INTERVAL=30

# Cache expiry sweep interval (default: 60s)
CACHE_CHECK_PERIOD=60

# ─── Admin Security ──────────────────────────────────────────
# Admin key for cache flush endpoint.
# REQUIRED — without it, POST /api/v1/admin/cache/flush returns 501.
# ADMIN_KEY=my-secret-admin-key

# ─── Proxy ───────────────────────────────────────────────────
# HTTP proxy for requests (e.g., behind corporate firewall)
# HTTP_PROXY=http://proxy.example.com:8080
