{
  "name": "rapi",
  "version": "1.0.0",
  "description": "Self-hosted Indian Railways REST API — 100% free, scraping-based",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run test/security-fuzzing.test.ts",
    "test:chaos": "vitest run test/chaos.test.ts",
    "test:memory": "vitest run test/memory-eviction.test.ts",
    "test:headers": "vitest run test/security-headers.test.ts",
    "test:all": "vitest run && npx tsx test/load-benchmark.ts",
    "bench": "npx tsx test/load-benchmark.ts"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "axios-cookiejar-support": "^7.0.0",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jimp": "^0.22.12",
    "node-cache": "^5.1.2",
    "tesseract.js": "^5.1.1",
    "tough-cookie": "^4.1.4",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "@types/tough-cookie": "^4.0.5",
    "@types/uuid": "^10.0.0",
    "autocannon": "^8.0.0",
    "nock": "^14.0.16",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
